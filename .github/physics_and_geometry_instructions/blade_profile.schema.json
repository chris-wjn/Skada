{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/skada/blade_profile.schema.json",
  "title": "Skada Blade Profile V1",
  "type": "object",
  "required": ["version", "units", "spine", "stations"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "units": { "type": "string", "enum": ["cm"] },
    "spine": {
      "type": "object",
      "required": ["type", "points"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "polyline" },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        }
      }
    },
    "stations": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/station" }
    },
    "pointTaper": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "fullers": {
      "type": "array",
      "items": { "$ref": "#/$defs/fuller" }
    },
    "flamboyance": { "$ref": "#/$defs/flamboyance" }
  },
  "$defs": {
    "station": {
      "type": "object",
      "required": ["s", "width", "thickness", "section"],
      "additionalProperties": false,
      "properties": {
        "s": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "width": { "type": "number", "exclusiveMinimum": 0.0 },
        "thickness": { "type": "number", "exclusiveMinimum": 0.0 },
        "section": {
          "type": "object",
          "required": ["r"],
          "additionalProperties": false,
          "properties": {
            "r": { "type": "number", "exclusiveMinimum": 0.0 },
            "edgeOffset": { "type": "number", "minimum": -1.0, "maximum": 1.0 }
          }
        }
      }
    },
    "fuller": {
      "type": "object",
      "required": ["s0", "s1", "width", "depth", "count", "profile"],
      "additionalProperties": false,
      "properties": {
        "s0": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "s1": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "width": { "type": "number", "minimum": 0.0 },
        "depth": { "type": "number", "minimum": 0.0 },
        "count": { "type": "integer", "minimum": 1 },
        "profile": { "type": "string", "enum": ["u", "v", "flat"] }
      }
    },
    "flamboyance": {
      "type": "object",
      "required": ["amplitude", "frequency", "phase"],
      "additionalProperties": false,
      "properties": {
        "amplitude": { "type": "number", "minimum": 0.0 },
        "frequency": { "type": "number", "minimum": 0.0 },
        "phase": { "type": "number" }
      }
    }
  }
}
