# Example rapier blade model - Complete double-sided blade
# All coordinates in centimeters
# Y-axis is along the blade length, origin at attachment point
# Diamond cross-section (4 vertices per slice) tapering to point

# Vertices for a rapier blade with diamond cross-section
# Base of blade (attachment point, Y=0)
v -1.5 0.0 0.0      # 1 - left edge
v 1.5 0.0 0.0       # 2 - right edge
v 0.0 0.0 0.4       # 3 - back ridge
v 0.0 0.0 -0.4      # 4 - front ridge

# Blade at 1/4 length (Y=18.75cm, width reduces)
v -1.2 18.75 0.0    # 5 - left edge
v 1.2 18.75 0.0     # 6 - right edge
v 0.0 18.75 0.35    # 7 - back ridge
v 0.0 18.75 -0.35   # 8 - front ridge

# Blade at 1/2 length (Y=37.5cm)
v -0.9 37.5 0.0     # 9 - left edge
v 0.9 37.5 0.0      # 10 - right edge
v 0.0 37.5 0.3      # 11 - back ridge
v 0.0 37.5 -0.3     # 12 - front ridge

# Blade at 3/4 length (Y=56.25cm)
v -0.5 56.25 0.0    # 13 - left edge
v 0.5 56.25 0.0     # 14 - right edge
v 0.0 56.25 0.2     # 15 - back ridge
v 0.0 56.25 -0.2    # 16 - front ridge

# Tip of blade (Y=75cm)
v 0.0 75.0 0.0      # 17 - point

# Faces (triangles, CCW winding for outward normals)
# Base caps (4 triangles forming diamond)
f 1 3 2
f 1 4 3
f 1 2 4
f 2 3 4

# Section 0 to 1/4 (8 triangular faces per section)
# Back face (positive Z)
f 1 5 7
f 1 7 3
f 2 3 7
f 2 7 6
# Front face (negative Z)
f 1 4 8
f 1 8 5
f 2 6 8
f 2 8 4

# Section 1/4 to 1/2
# Back face
f 5 9 11
f 5 11 7
f 6 7 11
f 6 11 10
# Front face
f 5 8 12
f 5 12 9
f 6 10 12
f 6 12 8

# Section 1/2 to 3/4
# Back face
f 9 13 15
f 9 15 11
f 10 11 15
f 10 15 14
# Front face
f 9 12 16
f 9 16 13
f 10 14 16
f 10 16 12

# Section 3/4 to tip (4 triangular faces)
# Back face
f 13 17 15
f 14 15 17
# Front face
f 13 16 17
f 14 17 16
