# Vanilla Minecraft Sword Blade - Accurate mesh model
# Based on sword.json weapon profile
# All coordinates in centimeters
# Blade: 500mm (50cm) length, 90mm (9cm) width, 20mm (2cm) thickness
# Y-axis along blade length, origin at attachment point (where blade meets handle)
# Diamond cross-section with beveled edges

# Cross-section vertices are arranged as:
#   3 (back ridge, +Z)
#   |
# 1-+-2 (left and right edges, X-axis)
#   |
#   4 (front ridge, -Z)

# ==== BASE OF BLADE (Y=0, attachment point) ====
# Full width: 9cm (4.5cm each side), thickness: 2cm (1cm each direction)
v -4.5 0.0 0.0
v 4.5 0.0 0.0
v 0.0 0.0 1.0
v 0.0 0.0 -1.0

# ==== BLADE AT 10% LENGTH (Y=5cm) ====
v -4.5 5.0 0.0
v 4.5 5.0 0.0
v 0.0 5.0 1.0
v 0.0 5.0 -1.0

# ==== BLADE AT 20% LENGTH (Y=10cm) ====
v -4.5 10.0 0.0
v 4.5 10.0 0.0
v 0.0 10.0 1.0
v 0.0 10.0 -1.0

# ==== BLADE AT 30% LENGTH (Y=15cm) ====
v -4.5 15.0 0.0
v 4.5 15.0 0.0
v 0.0 15.0 1.0
v 0.0 15.0 -1.0

# ==== BLADE AT 40% LENGTH (Y=20cm) ====
v -4.5 20.0 0.0
v 4.5 20.0 0.0
v 0.0 20.0 1.0
v 0.0 20.0 -1.0

# ==== BLADE AT 50% LENGTH (Y=25cm) ====
v -4.5 25.0 0.0
v 4.5 25.0 0.0
v 0.0 25.0 1.0
v 0.0 25.0 -1.0

# ==== BLADE AT 60% LENGTH (Y=30cm) ====
v -4.5 30.0 0.0
v 4.5 30.0 0.0
v 0.0 30.0 1.0
v 0.0 30.0 -1.0

# ==== BLADE AT 70% LENGTH (Y=35cm) ====
v -4.5 35.0 0.0
v 4.5 35.0 0.0
v 0.0 35.0 1.0
v 0.0 35.0 -1.0

# ==== BLADE AT 80% LENGTH (Y=40cm) ====
v -4.5 40.0 0.0
v 4.5 40.0 0.0
v 0.0 40.0 1.0
v 0.0 40.0 -1.0

# ==== BLADE AT 90% LENGTH (Y=45cm) - Start of tip taper ====
# Width starts tapering toward tip
v -3.5 45.0 0.0
v 3.5 45.0 0.0
v 0.0 45.0 0.8
v 0.0 45.0 -0.8

# ==== BLADE AT 95% LENGTH (Y=47.5cm) ====
v -2.0 47.5 0.0
v 2.0 47.5 0.0
v 0.0 47.5 0.5
v 0.0 47.5 -0.5

# ==== TIP OF BLADE (Y=50cm) ====
v 0.0 50.0 0.0

# ==============================================================
# FACES (triangles, CCW winding for outward normals)
# ==============================================================

# ---- BASE CAP (Y=0) ----
# Forms the diamond cross-section at blade base
f 1 3 2
f 2 3 4
f 1 2 4
f 1 4 3

# ---- SECTION: BASE to 10% ----
# Back-left face (vertices: edge-left, back-ridge)
f 1 5 7
f 1 7 3
# Back-right face
f 2 3 7
f 2 7 6
# Front-left face
f 1 4 8
f 1 8 5
# Front-right face
f 2 6 8
f 2 8 4

# ---- SECTION: 10% to 20% ----
f 5 9 11
f 5 11 7
f 6 7 11
f 6 11 10
f 5 8 12
f 5 12 9
f 6 10 12
f 6 12 8

# ---- SECTION: 20% to 30% ----
f 9 13 15
